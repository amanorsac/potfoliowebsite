# Response headers for Cloudflare Pages.
# Rules are matched top to bottom; the most specific match wins.
# https://developers.cloudflare.com/pages/configuration/headers/

/*
  # Never let a browser guess a file's type from its contents.
  X-Content-Type-Options: nosniff

  # Nobody may frame this site, which is what stops a clickjacking overlay.
  # frame-ancestors is the modern rule; X-Frame-Options is the old one, kept
  # for browsers that still only understand that.
  #
  # The rest of the policy is a list of the places this site is allowed to
  # fetch from, and it is worth being straight about what it is and is not
  # worth. script-src has to keep 'unsafe-inline', because nearly every
  # page here carries its own <script> block, and a policy that forbids
  # them would take the site down. That means an injected inline script
  # would still run: this policy does not stop cross-site scripting.
  #
  # What it does stop is worth having anyway. An injected <script src>
  # pointing anywhere but the handful of hosts below is refused. Stolen
  # data cannot be posted out, because connect-src and form-action name
  # every destination allowed. No plugin content can load at all.
  #
  # base-uri is 'self' rather than 'none', and that was learned the hard
  # way. worker.js puts a <base href> into every blog post so the page's
  # relative links resolve from the site root instead of from /blog/, and
  # 'none' forbade it - so "All posts" on a live post went to
  # /blog/blog.html and 404ed. 'self' still refuses a <base> pointing at
  # somebody else's server, which is the attack; it only permits the one
  # pointing at this site.
  #
  # Anything added to the site that talks to a new company has to be
  # added here too, or it will silently not work. That is the cost, and
  # it is also the point: nothing reaches out of these pages without
  # being written down first.
  #
  #   jsdelivr        the Supabase client library, used by the portal
  #   supabase        the database itself, and its realtime socket
  #   formspree       where the contact forms post
  #   youtube/ytimg   the player and its thumbnails
  #   spotify         embedded players in posts
  #   google*         AdSense, which loads through several of its own
  #                   hosts and is refused by any policy that misses one
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://www.youtube.com https://s.ytimg.com https://pagead2.googlesyndication.com https://tpc.googlesyndication.com https://googleads.g.doubleclick.net https://adservice.google.com https://www.google.com https://fundingchoicesmessages.google.com https://ep2.adtrafficquality.google; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; media-src 'self' blob:; connect-src 'self' https://kdxckigyhpnwhwgjdgqq.supabase.co wss://kdxckigyhpnwhwgjdgqq.supabase.co https://formspree.io https://www.youtube.com https://pagead2.googlesyndication.com https://googleads.g.doubleclick.net https://tpc.googlesyndication.com https://ep1.adtrafficquality.google https://ep2.adtrafficquality.google https://csi.gstatic.com; frame-src https://www.youtube-nocookie.com https://www.youtube.com https://open.spotify.com https://googleads.g.doubleclick.net https://tpc.googlesyndication.com https://www.google.com https://ep2.adtrafficquality.google; worker-src 'self' blob:; form-action 'self' https://formspree.io; upgrade-insecure-requests
  X-Frame-Options: DENY

  # Send the origin to other sites, never the full path. A client portal URL
  # should not travel in a referrer header.
  Referrer-Policy: strict-origin-when-cross-origin

  # HTTPS only, for a year, subdomains included.
  # Deliberately without "preload": that would add the domain to a list baked
  # into browsers, which is slow and awkward to undo. Add it once you are
  # certain every subdomain will always be HTTPS.
  Strict-Transport-Security: max-age=31536000; includeSubDomains

  # Keep this site's window separate from anything that opens it.
  # allow-popups rather than plain same-origin so a future sign-in popup
  # can still talk back to the page that opened it.
  Cross-Origin-Opener-Policy: same-origin-allow-popups

  # None of these are used, so none of them are permitted.
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()

# Photographs change rarely and are the bulk of what gets downloaded, so
# they are cached hard. Editing one means giving it a new filename.
/images/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/audio/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

# Typefaces never change: a new version would be a new file. Cached for a
# year and marked immutable, so a repeat visitor never asks for them again.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Shared CSS and JS do change, and there is no build step putting a hash in
# their names. An hour of hard caching, then a week where the browser may
# use the old copy once while it fetches the new one in the background.
/assets/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800
